# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Serveur uniquement — nécessaire pour les invitations d’utilisateurs. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secret aleatoire d’au moins 24 caracteres pour autoriser les inscriptions.
EPC_BETHEL_REGISTRATION_CODE=
